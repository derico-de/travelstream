# Per-machine tool config
.devshell.json
.sandboxsh.json
.pi/

.scratch/
node_modules/
.pnpm-store/
deploy/.env
deploy/backups/
frontend/.impeccable/

# Zope instance state. The etc/ configs are tracked deliberately; the rest
# (Data.fs and blobs, pid files, tus uploads) is per-machine runtime state.
# Excluding the *contents* rather than the directory itself, so the
# negations below can re-include etc/ — git never descends into an
# excluded directory.
backend/collective.travelstream/var/*
!backend/collective.travelstream/var/instance/
backend/collective.travelstream/var/instance/*
!backend/collective.travelstream/var/instance/etc/

# Same for the plone-setup instance: pid files and the Data.fs/blob directory
# are per-machine runtime state. The .gitkeep keeps var/ present on checkout.
backend/plone-setup/var/instance/*.pid
backend/plone-setup/var/instance/var/*
!backend/plone-setup/var/instance/var/.gitkeep

# mxdev checkouts (symlinks/clones) land here; only the placeholder is tracked.
backend/plone-setup/sources/*
!backend/plone-setup/sources/.gitkeep

# Editor swap files
*.swp
*.swo
*~
