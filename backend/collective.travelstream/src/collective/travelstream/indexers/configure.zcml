<configure
    xmlns="http://namespaces.zope.org/zope"
    i18n_domain="collective.travelstream">

  <adapter
      factory=".captured_at.dummy"
      name="captured_at"
      />

  <adapter
      factory=".captured_at.captured_at"
      name="captured_at"
      />

  <adapter
      factory=".latitude.dummy"
      name="latitude"
      />

  <adapter
      factory=".latitude.latitude"
      name="latitude"
      />

  <adapter
      factory=".longitude.dummy"
      name="longitude"
      />

  <adapter
      factory=".longitude.longitude"
      name="longitude"
      />

  <!-- No dummy guard for SearchableText: it exists site-wide and this
       adapter only specializes it for ITravelArticle objects. -->
  <adapter
      factory=".SearchableText.SearchableText"
      name="SearchableText"
      />

  <adapter
      factory=".processing_status.dummy"
      name="processing_status"
      />

  <adapter
      factory=".processing_status.processing_status"
      name="processing_status"
      />

</configure>
