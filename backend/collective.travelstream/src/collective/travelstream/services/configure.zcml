<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="collective.travelstream">

  <plone:service
      method="GET"
      for="plone.dexterity.interfaces.IDexterityContainer"
      factory=".travel_timeline.TravelTimelineService"
      name="@travel-timeline"
      permission="zope2.View"
      />

  <plone:service
      method="GET"
      for="plone.dexterity.interfaces.IDexterityContainer"
      factory=".travel_geojson.TravelGeojsonService"
      name="@travel-geojson"
      permission="zope2.View"
      />

  <plone:service
      method="GET"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      factory=".travelstream_settings.TravelstreamSettingsService"
      name="@travelstream-settings"
      permission="zope2.View"
      />

  <plone:service
      method="POST"
      for="collective.travelstream.behaviors.itravelarticle.ITravelArticle"
      factory=".travel_publish.TravelPublishService"
      name="@travel-publish"
      permission="cmf.ModifyPortalContent"
      />

</configure>
