<configure
    xmlns="http://namespaces.zope.org/zope"
    i18n_domain="collective.travelstream">

  <subscriber
      for="plone.app.contenttypes.interfaces.IImage
           zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler=".extract_exif_metadata.handler"
      />

  <!-- Re-extract on replace/edit of the image -->
  <subscriber
      for="plone.app.contenttypes.interfaces.IImage
           zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler=".extract_exif_metadata.handler"
      />

  <subscriber
      for="plone.app.contenttypes.interfaces.IFile
           zope.lifecycleevent.interfaces.IObjectAddedEvent"
      handler=".mark_video_processing.handler"
      />

  <subscriber
      for="plone.registry.interfaces.IRecordModifiedEvent"
      handler=".article_type_changed.handler"
      />

  <!-- A published article's embedded media is published: on the publish
       transition (any path) and on edits of already-published articles. -->
  <subscriber
      for="collective.travelstream.behaviors.itravelarticle.ITravelArticle
           Products.DCWorkflow.interfaces.IAfterTransitionEvent"
      handler=".publish_embedded_media.article_transitioned"
      />

  <subscriber
      for="collective.travelstream.behaviors.itravelarticle.ITravelArticle
           zope.lifecycleevent.interfaces.IObjectModifiedEvent"
      handler=".publish_embedded_media.article_modified"
      />

</configure>
