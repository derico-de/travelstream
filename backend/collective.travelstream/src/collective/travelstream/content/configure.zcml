<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="collective.travelstream">

  <plone:behavior
      title="ITrip"
      description="A folderish travel trip: date range, cover image, description"
      provides=".trip.ITrip"
      />

  <plone:behavior
      title="INote"
      description="A quick text note captured on the road"
      provides=".note.INote"
      />

</configure>
