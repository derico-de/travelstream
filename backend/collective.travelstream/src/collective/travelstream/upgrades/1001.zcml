<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="collective.travelstream">

  <genericsetup:registerProfile
      name="1001"
      title="collective.travelstream: upgrade to 1001"
      directory="1001"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:upgradeSteps
      source="1000"
      destination="1001"
      profile="collective.travelstream:default">

    <genericsetup:upgradeStep
        title="Article workflow and timeline membership"
        description="Bind Document to travelstream_workflow and add the captured behavior so articles can be published from the PWA and appear in the timeline"
        handler=".v1001.upgrade"
        />

    <genericsetup:upgradeDepends
        title="Apply profile version 1001"
        import_profile="collective.travelstream.upgrades:1001"
        />

  </genericsetup:upgradeSteps>

</configure>
