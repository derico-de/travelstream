<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="collective.travelstream">

  <genericsetup:registerProfile
      name="1002"
      title="collective.travelstream: upgrade to 1002"
      directory="1002"
      provides="Products.GenericSetup.interfaces.EXTENSION"
      />

  <genericsetup:upgradeSteps
      source="1001"
      destination="1002"
      profile="collective.travelstream:default">

    <genericsetup:upgradeStep
        title="Use plone.gallery and drop the bundled theme"
        description="Install plone.gallery for gallery grid and zoom, revert active theme to Barceloneta"
        handler=".v1002.upgrade"
        />

    <genericsetup:upgradeDepends
        title="Apply profile version 1002"
        import_profile="collective.travelstream.upgrades:1002"
        />

  </genericsetup:upgradeSteps>

</configure>
