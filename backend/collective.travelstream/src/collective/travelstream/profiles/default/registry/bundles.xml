<?xml version="1.0" encoding="UTF-8"?>
<registry xmlns:i18n="http://xml.zope.org/namespaces/i18n"
          i18n:domain="collective.travelstream">

  <!-- Addon-owned structural CSS (gallery video play badge). Gallery grid
       and zoom ship with plone.gallery's flexbin/spotlightjs bundles. -->
  <records prefix="plone.bundles/collective-travelstream"
           interface="Products.CMFPlone.interfaces.IBundleRegistry">
    <value key="enabled">True</value>
    <value key="jscompilation"></value>
    <value key="csscompilation">++plone++collective.travelstream/travelstream.css</value>
    <value key="depends">plone</value>
    <value key="load_async">False</value>
    <value key="load_defer">False</value>
  </records>

</registry>
