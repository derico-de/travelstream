<configure
  xmlns="http://namespaces.zope.org/zope"
  xmlns:zcml="http://namespaces.zope.org/zcml"
  i18n_domain="collective.travelstream">

  <configure zcml:condition="installed AccessControl.security">
  <!-- -*- extra stuff goes here -*- -->

    <permission
        id="collective.travelstream.AddNote"
        title="collective.travelstream: Add Note"
    />


    <permission
        id="collective.travelstream.AddTrip"
        title="collective.travelstream: Add Trip"
    />


  </configure>

</configure>
